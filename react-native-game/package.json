{
  "name": "crown-of-emeraldia-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle:game": "node ./scripts/build-inline-bundle.mjs",
    "build:dev-android": "eas build --profile development --platform android",
    "build:android-apk": "eas build -p android --profile preview",
    "build:android-aab": "eas build -p android --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.25",
    "expo-asset": "58.0.21",
    "expo-constants": "58.0.16",
    "expo-dev-client": "58.0.20",
    "expo-navigation-bar": "58.0.4",
    "expo-screen-orientation": "58.0.4",
    "expo-splash-screen": "58.0.14",
    "expo-status-bar": "58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "17.4.0",
    "react-native-safe-area-context": "5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
